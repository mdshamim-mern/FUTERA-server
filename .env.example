# All application-owned environment variables are validated with Zod.
# NODE_ENV is normally supplied by Next.js. Do not override it in hosted builds.
# NODE_ENV=development

# Absolute canonical app URL; change for preview/production deployments.
APP_URL=http://localhost:3000

# Explicit fixture mode, or mongodb for persisted catalog. No silent fallback.
CATALOG_SOURCE=sample

# Optional in sample mode. MongoDB mode requires BOTH values.
# When used: mongodb:// or mongodb+srv:// URI from your private secret store.
MONGODB_URI=
MONGODB_DB=

# Enable only with MongoDB replica-set transactions and explicit shipping policy.
COMMERCE_ENABLED=false
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=
# Shipping fees are integer BDT minor units. No live fee defaults are invented.
# SHIPPING_HOME_MINOR=
# SHIPPING_PICKUP_MINOR=
# PICKUP_ADDRESS=
# COD is the only implemented payment method. No online provider credentials are
# consumed: bKash/Nagad/Card stay coming soon until separately integrated/tested.
# Never expose credentials through NEXT_PUBLIC_* variables.

# Backend HTTP port; APP_URL is the public frontend origin.
PORT=4000
